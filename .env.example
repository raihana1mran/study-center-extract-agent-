# ─── OpenRouter ────────────────────────────────────────────────
# Get your free API key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── Database (SQLite) ─────────────────────────────────────────
# Default: SQLite file at db/nios.db (zero setup required)
# To use PostgreSQL instead: DATABASE_URL=postgresql://user:pass@localhost:5432/nios_db
DATABASE_URL=sqlite:///db/nios.db

# ─── NIOS ──────────────────────────────────────────────────────
NIOS_BASE_URL=https://sdmis.nios.ac.in
NIOS_LOCATOR_URL=https://sdmis.nios.ac.in/registration/locate-study-center

# ─── Agent Settings ────────────────────────────────────────────
# How many seconds to wait between requests (be polite to NIOS servers)
REQUEST_DELAY_SECONDS=2

# Max retry attempts per district
MAX_RETRIES=3

# Headless browser (true = no visible window)
HEADLESS=true

# ─── Scheduler ─────────────────────────────────────────────────
# Refresh interval in days
REFRESH_DAYS=30
